<?xml version="1.0" encoding="utf-8"?>
<!-- 차곡 스파스 패키지: Windows 11 우클릭 첫 화면 메뉴용.
     실제 프로그램 파일은 설치 폴더(ExternalLocation)에 있고, 이 패키지는 '정체성'과 메뉴 등록만 담는다.
     Publisher 는 서명 인증서 주체(installer/cert)와 정확히 같아야 한다. Version 은 빌드할 때 채운다. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="Sinsul.Chagok" Publisher="CN=Sinsul Chagok" Version="@VERSION@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>차곡</DisplayName>
    <PublisherDisplayName>주식회사신설</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="ko-KR" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="Chagok" Executable="Chagok.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="차곡" Description="압축 · 분할 압축 · 압축 해제"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="Chagok" Clsid="3BF35A03-70EC-4EEF-9CE7-FE2AD74D76A9" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="ChagokDir" Clsid="3BF35A03-70EC-4EEF-9CE7-FE2AD74D76A9" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="ChagokNewFolder" Clsid="D3F472C5-D1C4-45BB-9B69-8EABEECD599C" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="차곡 탐색기 메뉴">
              <com:Class Id="3BF35A03-70EC-4EEF-9CE7-FE2AD74D76A9" Path="ChagokShell.dll" ThreadingModel="STA" />
              <com:Class Id="D3F472C5-D1C4-45BB-9B69-8EABEECD599C" Path="ChagokShell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
